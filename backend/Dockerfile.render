FROM python:3.11-slim

# Install system dependencies for Tesseract OCR, WeasyPrint, and ONNX Runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    libpango-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PYTHONPATH=/app

# ── Layer 1: Install ML dependencies first (changes rarely, cached) ──
COPY backend/requirements-docker.txt .
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu \
    torch==2.3.0+cpu && \
    pip install --no-cache-dir onnxruntime==1.18.0 transformers==4.40.2 safetensors==0.4.3 onnx==1.16.0

# ── Layer 2: Install remaining dependencies ──
RUN pip install --no-cache-dir -r requirements-docker.txt

# ── Layer 3: Copy application code ──
COPY backend/ .

# ── Layer 4: Copy ML model into the image ──
# Render has no volume mounts, so the model must be baked in
COPY models/models ./ml_models/distilbert/

# Make startup script executable
RUN chmod +x start.sh

EXPOSE 8000

# Use the combined startup script (API + Celery worker)
CMD ["bash", "start.sh"]
